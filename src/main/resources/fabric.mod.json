{
  "schemaVersion": 1,
  "id": "player-switch",
  "version": "${version}",
  "name": "Player Switch",
  "description": "Switches the active player after set time intervals. Only one player can play the game at a time.",
  "authors": [
    "LCLP"
  ],
  "contact": {
    "homepage": "https://github.com/LCLPYT/player-switch",
    "sources": "https://github.com/LCLPYT/player-switch"
  },
  "license": "MIT",
  "icon": "assets/player-switch/icon.png",
  "environment": "*",
  "entrypoints": {
    "server": ["work.lclpnet.playerswitch.PlayerSwitchInit"]
  },
  "mixins": [
    "player-switch.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_compat}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "kibu": ">=0.153.0",
    "gaco": ">=0.14.2"
  },
  "suggests": {}
}